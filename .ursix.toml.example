# Ursix configuration file
# Copy to .ursix.toml in your project root or ~/.config/ursix/config.toml for global settings

# LLM provider: "ollama" (default) or "openai"
provider = "ollama"

# Model to use (provider-specific)
model = "llama3.2"

# Optional: Override the default provider URL
# Ollama default: http://localhost:11434
# OpenAI default: https://api.openai.com/v1
# provider_url = "http://localhost:11434"

# Token counting mode: "heuristic" (fast, default) or "full" (accurate, requires download)
tokenizer_mode = "heuristic"

# Request timeout in seconds (default: 60)
# timeout_secs = 60
